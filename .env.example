# Optional AI interpretation. Leave empty to keep using the local parser.
# Copy this file to .env.local and add your key privately. Restart npm run dev.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional backend setting: BILLSGO_DB_PATH=/absolute/path/billsgo.sqlite

# Optional Paystack account-name lookup. Use a test secret key initially.
# With no key, names are explicitly simulated. Provider failures never use fake names.
PAYSTACK_SECRET_KEY=
