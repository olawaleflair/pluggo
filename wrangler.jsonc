// Local placeholder only. Replace with YOUR database ID before remote commands.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pluggo-fork",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pluggo-demo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
